{
  "name": "@polign/openclaw-recall",
  "version": "0.1.1",
  "type": "module",
  "description": "Long-term memory for OpenClaw agents, kept in Recall by Polign: corrections replace, history stays, reads as of any time.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polign/polign.git",
    "directory": "plugins/openclaw"
  },
  "homepage": "https://polign.com/openclaw",
  "keywords": [
    "openclaw",
    "plugin",
    "memory",
    "recall",
    "polign",
    "long-term-memory"
  ],
  "files": [
    "dist/",
    "index.ts",
    "src/",
    "openclaw.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.10.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.2",
      "minGatewayVersion": "2026.10.2"
    }
  }
}
