# LiveKit project (from the LiveKit Cloud dashboard or your self-hosted server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model providers used by agent.py
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Recall memory. Leave POLIGN_URL unset and the agent keeps its memory in
# ./recall-data and runs the database itself. Set it to store into a polign_db
# server you run, which is what a deployed worker should do.
# For S3, start that server with -store s3://bucket/prefix (see README).
# For GCS, use -store gcs://bucket/prefix and Google ADC on the server.
# POLIGN_URL is its HTTP(S) address, not the S3 URI. AWS credentials stay on
# the server; POLIGN_API_KEY is the Polign key registered by that server.
# POLIGN_URL=http://memory.internal:23000
# POLIGN_API_KEY=
POLIGN_COLLECTION=callers
# Optional: your own predicate registry. Unset uses the starter voice registry.
# POLIGN_PREDICATES=./callers.json
